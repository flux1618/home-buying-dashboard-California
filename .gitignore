.env
.env.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
build/
dist/

# Batch run outputs. These contain addresses and full financial analyses of real
# properties, which is exactly the kind of thing that should not land in a public repo
# by accident. Default --out-dir is runs/.
runs/

# Local profile overrides with real financial figures
buyer_profile.local.toml

# The saved-property ledger. Contains real addresses of houses under consideration, full
# financial analyses of them, and a private decision journal. It defaults to the XDG data
# directory precisely so it is never inside this tree, but a `--db ./ledger.db` while
# debugging should not be one `git add -A` away from being published.
ledger.db
*.db
*.db-wal
*.db-shm

# Intermediate build output from the California port. tools/rebuild_la_geospatial.py writes
# geospatial.json (1.3 MB) purely so a rebuild can be re-run without re-hitting Census
# TIGERweb, FEMA, and OSRM; every value it holds is already published inside data.json.
# The small summary and report files stay tracked because they record WHEN the live sources
# were read, which is provenance rather than duplication.
data/la_live/geospatial.json
